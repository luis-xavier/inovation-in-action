		<Image src={imgRibbonVector} alt="" class="md:block hidden w-sm" />
		<Image src={imgRibbbonVectorM} alt="" class="md:hidden block w-[85%] self-end" />
</section>

<style>
#Conferencistas{
    position: relative;
    >img{
        position: absolute;
        bottom: -29%;
        right: 0;
        z-index: 0;
        width: 23%;
        opacity: .2;
    }
    article{
        position: relative;
        display: flex;
        flex-wrap: wrap;
        column-gap: 3%;
        row-gap: 3em;
        justify-content: flex-start;
        margin: 40px auto 200px;
        width: clamp(90%, 94%, 1200px);
        max-width: 1200px;
        z-index: 1;
    }
}
.card-speaker{
    width: clamp(300px, 31%, 500px);
    display: grid;
    grid-template-columns: 40% 1fr;
    gap: 1em;
    justify-content: center;
    align-items: center;
    img{
        order: -1;
    }
    h5{
        font-size: 1.15em;
        font-weight: 700;
    }
    p{
        font-size: .85em;
        font-weight: 300;
        font-style: italic;
    }
    a{
        color: #01a884;
        font-size: .85em;
        text-decoration: underline;
        font-weight: 600;
    }
}
@media screen and (max-width: 768px){
    #Conferencistas{ 
        article{
        }
        >img{
            width: 50%;
            bottom: -15%;
            opacity: .5;
        }
    }
    .card-speaker{
        width: 48%;
        img{
            justify-self: end;

        }
    }
}
@media screen and (max-width: 550px){
    .card-speaker{
        width: 100%;
    }
    #Conferencistas{
        article{
            margin: 30px auto 150px;
        }
        >img{
            bottom: -8%;
        }
    }
}
</style>