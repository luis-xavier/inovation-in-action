                </div>
                <Image src={imgMarioLopez} alt="" class="block md:w-auto w-[160px]"/>
            </div-->
            <div class="card-speaker">
                <div >
                    <h5>Oscar Morales</h5>
                    <p >Especialista Comercial</p>
                    <p >Charofil</p>
                    <a href="https://www.linkedin.com/in/oscar-morales-carranza-466a73346/" target="_blank">Ver perfil de Linkedin</a>
                </div>
                <Image src={imgOscarMorales} alt="" class="block md:w-auto w-[160px]"/>
            </div>
