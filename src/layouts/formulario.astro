<div class="overlay-box" id="overlay-box">
  <div class="modalbox-wrapper" id="modal_box-wrapper">
    <div id="close-modal">
        <svg id="Layer_1" xmlns="http://www.w3.org/2000/svg" version="1.1" viewBox="0 0 20 20">
          <path d="M11.2,10l3.8-3.8c.3-.3.3-.9,0-1.2-.3-.3-.9-.3-1.2,0l-3.8,3.8-3.8-3.8c-.3-.3-.9-.3-1.2,0-.3.3-.3.9,0,1.2l3.8,3.8-3.8,3.8c-.3.3-.3.9,0,1.2.3.3.9.3,1.2,0l3.8-3.8,3.8,3.8c.3.3.9.3,1.2,0,.3-.3.3-.9,0-1.2l-3.8-3.8Z" style="fill: #fff;"/>
          <path d="M10,1.5c4.7,0,8.5,3.8,8.5,8.5s-3.8,8.5-8.5,8.5S1.5,14.7,1.5,10,5.3,1.5,10,1.5M10,0C4.5,0,0,4.5,0,10s4.5,10,10,10,10-4.5,10-10S15.5,0,10,0h0Z" style="fill: #fff;"/>
        </svg>
    </div>
    <article class="text-center text-gray-200">
      <h3 class="md:text-6xl text-3xl font-bold mb-6">Recibimos tu solicitud</h3>
      <p class="text-lg">En CommScope nos alegra tu interés.</p>
      <p class="text-lg mt-2">Pronto recibirás un correo el cuál confirmará tu participación.</p>
      <p class="text-lg mt-2">En caso de no recibir la confirmación en 24 horas favor de mandar un correo a:</p>
      <p class="text-base mt-2">innovationinaction2026@hotmail.com</p>
      <p class="text-lg mt-2">Favor de revisar su bandeja de correo no deseado.</p>
      <p class="sm:text-3xl text-3xl font-bold mt-8">¡GRACIAS!</p>
    </article>
</div>

</div>
<!-- FIN DE MODAL BOX -->

<script>
const form = document.getElementById('registro');
form.addEventListener('submit', async (e) => {
  e.preventDefault();
  const loader = '<span class="loader" style="width: 26px; height: 26px; border: 4px solid #FFF; border-bottom-color: transparent; border-radius: 50%; display: inline-block; box-sizing: border-box; animation: rotation 1s linear infinite;"></span>';
  const boton = document.getElementById('enviarbtn');
  setTimeout(function () {
      boton.innerHTML = loader;
      boton.removeAttribute('type')
  }, 50);

  const formData = new FormData(form);
  const data = Object.fromEntries(formData.entries());
  console.dir(data)

  try {
    const response = await fetch('https://innovationinaction.com.mx/registro.php', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      const result = await response.json();

    if (result.status === 'success') {
        //alert('Gracias por tu registro, pronto nos pondremos en contacto contigo.');
        //window.location.replace("/gracias");
		showModal();
        form.reset();
      } else {
        alert('Error: ' + (result.error || 'Error desconocido'));
      }

    } catch (err) {
      console.error(err);
      alert('No se pudo enviar el formulario.');
    }
});


// DIÁLOGO MODAL
let elem = document.getElementById('overlay-box'),
    fadeInInterval,
    fadeOutInterval;
        
function showModal(){
    clearInterval(fadeInInterval);
    clearInterval(fadeOutInterval);
    elem.fadeIn = function(timing) {
        let newValue = 0;
        elem.style.display = 'block';
        elem.style.opacity = 0;
        fadeInInterval = setInterval(function(){
            if (newValue < 1) {
                newValue += 0.01;
            } else if (newValue === 1) {
                clearInterval(fadeInInterval);
            }
            elem.style.opacity = newValue;
        }, timing);
    }
    elem.fadeIn(4);
    document.body.classList.add("stop-scrolling");
};

let cerrartrigger = document.querySelectorAll('#overlay-box, #close-modal svg')

cerrartrigger.forEach(function (userItem) {
  userItem.addEventListener('click',function(){
    clearInterval(fadeInInterval);
    clearInterval(fadeOutInterval);
    elem.fadeOut = function(timing) {
        let newValue = 1;
        elem.style.opacity = 1;
        fadeOutInterval = setInterval(function(){ 
            if (newValue > 0) {
            newValue -= 0.01;
            } else if (newValue < 0) {
            elem.style.opacity = 0;
            elem.style.display = 'none';
            clearInterval(fadeOutInterval);
            }
            elem.style.opacity = newValue;
        }, timing);
    }
    elem.fadeOut(3);
    document.body.classList.remove("stop-scrolling");
});
}

)
document.getElementById('modal_box-wrapper').addEventListener("click",function(e){
    e.stopPropagation()
});


</script>