---
import '../styles/modal.css';
import {Image} from 'astro:assets';
import Title from '../components/TitleInovation.astro';
import MainLogo from '../assets/logo-innovation.svg';
import imgRibbonVector from '../assets/ribbon-color.png';
import imgRibbbonVectorM  from '../assets/ribbon-color-m.png'
import SponsorAxis from '../assets/sponsors-axis.png';
import SponsorCdc from '../assets/sponsors-cdc.png';
import SponsorLuguer from '../assets/sponsors-luguer.png';
import SponsorCharofil from '../assets/sponsors-charofil.png';
import SponsorVerkada from '../assets/sponsors-verkada.png';
import SponsorFluke from '../assets/sponsors-fluke.png';
import SponsorWescoAnixter from '../assets/sponsors-wesco-anixter.png';
import SponsorDCX from '../assets/sponsors-dcx.png';
import SponsorSchneider from '../assets/sponsors-schneider.png';
import SponsorGenetec from '../assets/sponsors-genetec.png';
---
<section id="Sponsors">
	<div class="my-8 md:ml-8 ml-4">
		<Title title="SPONSORS" />
	</div>

	<div class="flex justify-between items-center flex-col md:flex-row gap-8">

		<div class="flex flex-col gap-14 w-full">
			<div class="flex gap-2 flex-col items-center w-[90%] mx-auto">
				<h5 class="font-bold text-xl">Patrocinadores World Cup</h5>
				<div class="sponsor-gradient"></div>
				<div class="sponsor-list">
					<Image src={SponsorLuguer} alt="" class="trigger-modal" data-modalname="luguer" />
				</div>
			</div>

			<div class="flex gap-2 flex-col items-center w-[90%] mx-auto">
				<h5 class="font-bold text-xl">Patrocinadores Champions League</h5>
				<div class="sponsor-gradient"></div>
				<div class="sponsor-list">
                    <Image src={SponsorAxis} alt="" class="trigger-modal" data-modalname="axis" />
                    <Image src={SponsorCharofil} alt="" class="trigger-modal" data-modalname="charofil" />
                    <Image src={SponsorSchneider} alt="Logo Schneider" class="trigger-modal" data-modalname="schneider"  />
                    <Image src={SponsorVerkada} alt="" class="trigger-modal" data-modalname="verkada" />
				</div>
			</div>

			<div class="flex gap-2 flex-col items-center w-[90%] mx-auto">
				<h5 class="font-bold text-xl">Patrocinadores Mex League</h5>
				<div class="sponsor-gradient"></div>
				<div class="sponsor-list">
                    <Image src={SponsorCdc} alt="" class="trigger-modal" data-modalname="cdc" />
                    <Image src={SponsorDCX} alt="Logo DCX" class="trigger-modal" data-modalname="dcx"  />
                    <Image src={SponsorFluke} alt="" class="trigger-modal" data-modalname="fluke" />
                    <Image src={SponsorGenetec} alt="Logo Genetec" class="trigger-modal" data-modalname="genetec"  />
                    <Image src={SponsorWescoAnixter} alt="" class="trigger-modal" data-modalname="wesco" />
				</div>
			</div>
			<MainLogo class="w-[50%] md:w-[250px] mx-auto md:block hidden" />
		</div>

		<Image src={imgRibbonVector} alt="" class="md:block hidden w-sm" />
		<Image src={imgRibbbonVectorM} alt="" class="md:hidden block w-[85%] self-end" />
	</div>
</section>


<div class="modal-overlay" id="axis">
    <div class="close-mbox-wrapper">
        <div class="close-modal">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M11.1999 9.9999L14.9999 6.1999C15.2999 5.8999 15.2999 5.2999 14.9999 4.9999C14.6999 4.6999 14.0999 4.6999 13.7999 4.9999L9.9999 8.7999L6.1999 4.9999C5.8999 4.6999 5.2999 4.6999 4.9999 4.9999C4.6999 5.2999 4.6999 5.8999 4.9999 6.1999L8.7999 9.9999L4.9999 13.7999C4.6999 14.0999 4.6999 14.6999 4.9999 14.9999C5.2999 15.2999 5.8999 15.2999 6.1999 14.9999L9.9999 11.1999L13.7999 14.9999C14.0999 15.2999 14.6999 15.2999 14.9999 14.9999C15.2999 14.6999 15.2999 14.0999 14.9999 13.7999L11.1999 9.9999Z"/>
            </svg>
        </div>
        <div class="modalbox">
            <article class="">
                <Image src={SponsorAxis} alt="" />
                <p class="text-normal">Como líder en el sector de la videovigilancia, desarrollamos y suministramos soluciones de red innovadoras que mejoran la seguridad, la protección, la inteligencia empresarial y la eficiencia operativa para nuestros clientes en todo el mundo.</p>
                <div class="flex sm:flex-row flex-col gap-6 mt-6 mb-1 justify-center">
                    <a href="https://www.axis.com/es-mx" target="_blank">Visitar sitio</a>
                    <a href="https://www.linkedin.com/company/axis-communications/" target="_blank">Seguir en Linkedin</a>
                </div>
            </article>
        </div>
    </div>
</div>
<!-- FIN DE MODAL BOX -->

