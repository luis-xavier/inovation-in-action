<script src="../scripts/modal.js"></script>

<script>
// DIÁLOGO MODAL
let elem = document.getElementById('final-box'),
    fadeInInterval,
    fadeOutInterval;

function showModalFinal(){
    clearInterval(fadeInInterval);
    clearInterval(fadeOutInterval);
    elem.fadeIn = function(timing) {
        let newValue = 0;
        elem.style.display = 'block';
        elem.style.opacity = 0;
        fadeInInterval = setInterval(function(){
            if (newValue < 1) {
                newValue += 0.01;
            } else if (newValue === 1) {
                clearInterval(fadeInInterval);
            }
            elem.style.opacity = newValue;
        }, timing);
    }
    elem.fadeIn(4);
    document.body.classList.add("stop-scrolling");
};

let cerrartrigger = document.querySelectorAll('#overlay-box, #close-modal svg')

cerrartrigger.forEach(function (userItem) {
  userItem.addEventListener('click',function(){
    clearInterval(fadeInInterval);
    clearInterval(fadeOutInterval);
    elem.fadeOut = function(timing) {
        let newValue = 1;
        elem.style.opacity = 1;
        fadeOutInterval = setInterval(function(){ 
            if (newValue > 0) {
            newValue -= 0.01;
            } else if (newValue < 0) {
            elem.style.opacity = 0;
            elem.style.display = 'none';
            clearInterval(fadeOutInterval);
            }
            elem.style.opacity = newValue;
        }, timing);
    }
    elem.fadeOut(3);
    document.body.classList.remove("stop-scrolling");
});
}

)
document.getElementById('modal_box-wrapper').addEventListener("click",function(e){
    e.stopPropagation()
});

setTimeout(showModalFinal(), 1000);
</script>